# Environment
SV_ENV=dev

# Databases
SV_DATABASE_URL=postgresql+asyncpg://sv:sv@localhost:5432/sv
SV_REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
SV_S3_ENDPOINT=http://localhost:9000
SV_S3_BUCKET=sentinel-v
SV_S3_ACCESS_KEY=minioadmin
SV_S3_SECRET_KEY=minioadmin

# Engine & Hardware
SV_ENGINE_MODE=mock
SV_MODEL_BUNDLE=bundle-2026-11-default
SV_DEVICE=cuda:0
SV_MAX_UPLOAD_MB=500
SV_MAX_DURATION_S=600
SV_MAX_TRACKS=4
SV_K_CLIPS=8

# Retention
SV_RETENTION_MEDIA_DAYS=30
SV_RETENTION_EVIDENCE_DAYS=180

# Cryptography & Receipts
SV_RECEIPT_SIGNING_KEY_PATH=secrets/receipt_ed25519.pem
SV_PUBLIC_SCORE_DECIMALS=2
SV_WEBHOOK_SECRET=sv_test_webhook_secret_32bytes_min

# Blockchain Anchoring (Optional)
SV_ANCHOR_ENABLED=false
SV_ANCHOR_RPC_URL=https://rpc.sepolia.org
SV_ANCHOR_CONTRACT=0x0000000000000000000000000000000000000000
SV_ANCHOR_KEY_PATH=secrets/anchor_private_key.hex
SV_ANCHOR_CHAIN_ID=11155111
SV_ANCHOR_BATCH_SECONDS=600

# Integrations
SV_COMPAT_SENTINEL_ENABLED=true
SV_COMPAT_SYNC_TIMEOUT_S=50
SV_SENTINEL_WEBHOOK_URL=http://localhost:5000/api/v1/sv/webhook

# Auxiliary Signals
SV_GEN_IMAGE_ONNX=models/aux/swinv2_ai_image/model.onnx

# Compliance
SV_LICENSE_ACK=research-only
